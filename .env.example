# Google Gemini API Key for Synthesis and Multilingual Explanation Agent
GEMINI_API_KEY=your_gemini_api_key_here

# CARTO Basemaps API Key (Raster Nautical Tiles)
VITE_CARTO_API_KEY=your_carto_basemaps_api_key_here

# Default Harbour
DEFAULT_HARBOUR_ID=rameswaram

# Environment (development | production)
ENVIRONMENT=development

# Strict CORS Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,https://tarang-0v0t.onrender.com

# Server Port
PORT=8000

# Custom Domain Configuration
CUSTOM_DOMAIN=orca.marine.gov.in
VITE_CUSTOM_DOMAIN=orca.marine.gov.in
